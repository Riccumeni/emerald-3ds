+/* Native dual-screen presentation. All inventory mutations and callbacks
+ * remain in the original task; UI commands are consumed before RunTasks. */
+static void CtrBag_CopyText(u8 *dst, unsigned size, const u8 *src)
+{
+    unsigned n = 0;
+    if (src != NULL)
+        while (n + 1 < size && src[n] != EOS)
+        {
+            dst[n] = src[n];
+            ++n;
+        }
+    dst[n] = EOS;
+}
+
+static void CtrBag_ResetNative(void)
+{
+    ++sCtrBagSerial;
+    sCtrBagTask = TASK_NONE;
+    sCtrBagCommand = 0xFF;
+    sCtrBagYesNo = FALSE;
+    sCtrBagMessage[0] = EOS;
+    memset(&sCtrTouch, 0, sizeof(sCtrTouch));
+}
+
+bool CtrBag_DualShown(void)
+{
+    return CtrBag_IsOpen();
+}
+
+static u8 CtrBag_NativeMode(void)
+{
+    TaskFunc func;
+    if (!CtrBag_DualShown() || sCtrBagTask >= NUM_TASKS || !gTasks[sCtrBagTask].isActive)
+        return CTR_BAG_BUSY;
+    if (gBagPosition.location == ITEMMENULOCATION_WALLY)
+        return CTR_BAG_BUSY;
+    func = gTasks[sCtrBagTask].func;
+    if (func == Task_BagMenu_HandleInput) return CTR_BAG_LIST;
+    if (func == Task_HandleSwappingItemsInput) return CTR_BAG_SWAP;
+    if (func == Task_ItemContext_SingleRow || func == Task_ItemContext_MultipleRows) return CTR_BAG_CONTEXT;
+    if (func == Task_ChooseHowManyToToss || func == Task_ChooseHowManyToSell || func == Task_ChooseHowManyToDeposit)
+        return CTR_BAG_QUANTITY;
+    if (sCtrBagYesNo && func == sCtrBagYesNoFunc) return CTR_BAG_YESNO;
+    if (func == Task_SwitchBagPocket || func == Task_CloseBagMenu || gPaletteFade.active)
+        return CTR_BAG_BUSY;
+    return CTR_BAG_MESSAGE;
+}
+
+void CtrBag_ReadView(CtrBagView *view)
+{
+    unsigned i, total, index;
+    u8 mode;
+    s16 *data;
+    memset(view, 0, sizeof(*view));
+    if (!CtrBag_DualShown() || gBagPosition.pocket >= POCKETS_COUNT)
+        return;
+    view->ready = TRUE;
+    view->pocket = gBagPosition.pocket;
+    view->locked = gBagMenu->pocketSwitchDisabled;
+    view->mode = mode = CtrBag_NativeMode();
+    total = gBagMenu->numItemStacks[gBagPosition.pocket];
+    if (!gBagMenu->hideCloseBagText && total) --total;
+    view->count = total;
+    index = GetItemListPosition(gBagPosition.pocket);
+    if (mode == CTR_BAG_CONTEXT || mode == CTR_BAG_QUANTITY || mode == CTR_BAG_YESNO || mode == CTR_BAG_MESSAGE)
+        if (sCtrBagTask < NUM_TASKS) index = gTasks[sCtrBagTask].data[1];
+    view->selected = index;
+    view->first = (total && index >= total ? (total - 1) : index) / CTR_BAG_ROWS * CTR_BAG_ROWS;
+    view->registered = gSaveBlock1Ptr->registeredItem;
+    for (i = 0; i < CTR_BAG_ROWS && view->first + i < total; ++i)
+    {
+        view->items[i] = BagGetItemIdByPocketPosition(gBagPosition.pocket + 1, view->first + i);
+        view->quantities[i] = BagGetQuantityByPocketPosition(gBagPosition.pocket + 1, view->first + i);
+        GetItemNameFromPocket(view->names[i], view->items[i]);
+    }
+    CtrBag_CopyText(view->message, sizeof(view->message), sCtrBagMessage);
+    if (mode == CTR_BAG_CONTEXT)
+    {
+        view->actionCount = gBagMenu->contextMenuNumItems;
+        if (view->actionCount > 6) view->actionCount = 6;
+        view->cursor = Menu_GetCursorPos();
+        for (i = 0; i < view->actionCount; ++i)
+        {
+            unsigned action = gBagMenu->contextMenuItemsPtr[i];
+            if (action >= ARRAY_COUNT(sItemMenuActions) || action == ACTION_DUMMY) continue;
+            view->actionValid[i] = TRUE;
+            CtrBag_CopyText(view->actions[i], sizeof(view->actions[i]), sItemMenuActions[action].text);
+        }
+    }
+    if (mode == CTR_BAG_YESNO) view->cursor = Menu_GetCursorPos();
+    if (sCtrBagTask < NUM_TASKS)
+    {
+        data = gTasks[sCtrBagTask].data;
+        view->quantity = tItemCount;
+        view->maximum = tQuantity;
+    }
+}
+
+void CtrBag_ReadTop(CtrBagTop *top)
+{
+    u8 id, mode;
+    unsigned index, total, item;
+    const struct Sprite *sprite;
+    memset(top, 0, sizeof(*top));
+    top->serial = sCtrBagSerial;
+    if (!CtrBag_DualShown()) return;
+    top->pocket = gBagPosition.pocket;
+    mode = CtrBag_NativeMode();
+    index = GetItemListPosition(gBagPosition.pocket);
+    total = gBagMenu->numItemStacks[gBagPosition.pocket];
+    if (!gBagMenu->hideCloseBagText && total) --total;
+    item = index < total ? BagGetItemIdByPocketPosition(gBagPosition.pocket + 1, index) : ITEM_NONE;
+    CtrBag_CopyText(top->description, sizeof(top->description),
+                   mode == CTR_BAG_LIST || mode == CTR_BAG_CONTEXT || mode == CTR_BAG_BUSY
+                   ? item ? GetItemDescription(item) : gText_CloseBag : sCtrBagMessage);
+    id = gBagMenu->spriteIds[ITEMMENUSPRITE_BAG];
+    if (id >= MAX_SPRITES || !gSprites[id].inUse) return;
+    sprite = &gSprites[id];
+    if (sprite->oam.tileNum * TILE_SIZE_4BPP + sizeof(top->tiles) > OBJ_VRAM0_SIZE) return;
+    memcpy(top->tiles, (const void *)(OBJ_VRAM0 + sprite->oam.tileNum * TILE_SIZE_4BPP), sizeof(top->tiles));
+    memcpy(top->palette, gPlttBufferUnfaded + 256 + sprite->oam.paletteNum * 16, sizeof(top->palette));
+    top->x = sprite->x2;
+    top->y = sprite->y2;
+    top->pa = top->pd = 256;
+    if (sprite->oam.affineMode)
+    {
+        const struct OamMatrix *matrix = &gOamMatrices[sprite->oam.matrixNum];
+        top->pa = matrix->a; top->pb = matrix->b; top->pc = matrix->c; top->pd = matrix->d;
+    }
+    top->ready = TRUE;
+}
