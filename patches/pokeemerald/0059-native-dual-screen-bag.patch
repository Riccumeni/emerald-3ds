+void CtrBag_Command(unsigned command, int value)
+{
+    if (!CtrBag_DualShown() || gPaletteFade.active || MenuHelpers_ShouldWaitForLinkRecv()) return;
+    sCtrBagCommand = command;
+    sCtrBagValue = value;
+}
+
+static void CtrBag_SelectNative(u8 taskId, unsigned index)
+{
+    s16 *data = gTasks[taskId].data;
+    u16 scroll, row;
+    unsigned shown = gBagMenu->numShownItems[gBagPosition.pocket];
+    if (!shown || index >= gBagMenu->numItemStacks[gBagPosition.pocket]) return;
+    ListMenuGetScrollAndRow(tListTaskId, &scroll, &row);
+    if (index < scroll) CtrListMenu_Scroll(tListTaskId, (s16)index - scroll);
+    else if (index >= scroll + shown) CtrListMenu_Scroll(tListTaskId, (s16)index - scroll - shown + 1);
+    ListMenuGetScrollAndRow(tListTaskId, &scroll, &row);
+    CtrListMenu_Select(tListTaskId, index - scroll);
+    ListMenuGetScrollAndRow(tListTaskId, &gBagPosition.scrollPosition[gBagPosition.pocket], &gBagPosition.cursorPosition[gBagPosition.pocket]);
+}
+
+static void CtrBag_NativeInput(void)
+{
+    u8 command = sCtrBagCommand, mode = CtrBag_NativeMode();
+    s16 value = sCtrBagValue;
+    u16 keys;
+    unsigned index, count;
+    s16 *data;
+    sCtrBagCommand = 0xFF;
+    if (!CtrBag_DualShown() || gPaletteFade.active || MenuHelpers_ShouldWaitForLinkRecv() || sCtrBagTask >= NUM_TASKS)
+        return;
+    data = gTasks[sCtrBagTask].data;
+    if (mode == CTR_BAG_LIST || mode == CTR_BAG_SWAP)
+    {
+        index = GetItemListPosition(gBagPosition.pocket);
+        count = gBagMenu->numItemStacks[gBagPosition.pocket];
+        if (!gBagMenu->hideCloseBagText && count) --count;
+        keys = gMain.newAndRepeatedKeys & (DPAD_UP | DPAD_DOWN | DPAD_LEFT | DPAD_RIGHT);
+        if (keys && count)
+        {
+            int next = index;
+            if (keys & DPAD_UP) next -= 2;
+            else if (keys & DPAD_DOWN) next += 2;
+            else if ((keys & DPAD_LEFT) && (index & 1)) --next;
+            else if ((keys & DPAD_RIGHT) && !(index & 1)) ++next;
+            if (next < 0) next = 0;
+            if (next >= (int)count) next = count - 1;
+            if (next != (int)index) { CtrBag_SelectNative(sCtrBagTask, next); PlaySE(SE_SELECT); }
+        }
+        gMain.newKeys &= ~(DPAD_UP | DPAD_DOWN | DPAD_LEFT | DPAD_RIGHT);
+        gMain.newAndRepeatedKeys &= ~(DPAD_UP | DPAD_DOWN | DPAD_LEFT | DPAD_RIGHT);
+        if (command == CTR_BAG_POCKET && mode == CTR_BAG_LIST && !gBagMenu->pocketSwitchDisabled && value >= 0 && value < POCKETS_COUNT)
+        {
+            int delta = value - gBagPosition.pocket;
+            if (delta > 2) delta -= POCKETS_COUNT;
+            if (delta < -2) delta += POCKETS_COUNT;
+            if (delta) { PlaySE(SE_SELECT); SwitchBagPocket(sCtrBagTask, delta, FALSE); }
+        }
+        else if (command == CTR_BAG_SELECT && value >= 0 && value < (int)count)
+        {
+            CtrBag_SelectNative(sCtrBagTask, value);
+            if (value == (int)index) gMain.newKeys |= A_BUTTON;
+            else PlaySE(SE_SELECT);
+        }
+        else if (command == CTR_BAG_PAGE && count)
+        {
+            int next = (int)index + value * CTR_BAG_ROWS;
+            if (next < 0) next = 0;
+            if (next >= (int)count) next = count - 1;
+            CtrBag_SelectNative(sCtrBagTask, next);
+            PlaySE(SE_SELECT);
+        }
+    }
+    if (command == CTR_BAG_ACTION && mode == CTR_BAG_CONTEXT && value >= 0 && value < gBagMenu->contextMenuNumItems && IsValidContextMenuPos(value))
+    {
+        unsigned action = gBagMenu->contextMenuItemsPtr[value];
+        PlaySE(SE_SELECT);
+        sItemMenuActions[action].func.void_u8(sCtrBagTask);
+    }
+    else if (command == CTR_BAG_ACTION && mode == CTR_BAG_YESNO && value >= 0 && value <= 1)
+    {
+        CtrMenu_Choose(value, FALSE);
+        gMain.newKeys |= A_BUTTON;
+    }
+    else if (command == CTR_BAG_ADJUST && mode == CTR_BAG_QUANTITY)
+    {
+        int quantity = tItemCount + value;
+        if (quantity < 1) quantity = 1;
+        if (quantity > tQuantity) quantity = tQuantity;
+        tItemCount = quantity;
+        PlaySE(SE_SELECT);
+    }
+    else if (command == CTR_BAG_CONFIRM)
+        gMain.newKeys |= A_BUTTON;
+    else if (command == CTR_BAG_BACK)
+        gMain.newKeys |= B_BUTTON;
+}
